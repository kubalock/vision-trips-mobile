PORT=3000
AUTH_DATABASE_PATH=.data/auth.sqlite
AIRTABLE_ENGAGEMENT_TABLE=
MOBILE_ORIGIN=http://localhost:4200
TRUST_PROXY=
ENABLE_API_DOCS=false
RATE_LIMIT_PER_MINUTE=180
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_MEDIA_PER_MINUTE=600
# Public address of this API including /v1 (needed behind a proxy for signed photo links), e.g. https://api.example.com/v1
PUBLIC_API_URL=
AIRTABLE_TOKEN=
AIRTABLE_REQUEST_TIMEOUT_MS=10000
AIRTABLE_MAX_ATTEMPTS=3
AIRTABLE_MIN_REQUEST_INTERVAL_MS=220
AIRTABLE_RETRY_BASE_MS=500
VISION_LINK_SECRET=
VISION_LINK_SECRET_PREVIOUS=
RESEND_API_KEY=
VISION_EMAIL_FROM=Vision Trips <onboarding@resend.dev>
VISION_AUTOMATION_KEY=
VISION_TRIP_LINK_BASE_URL=http://localhost:4200/trip

# Customer App invitations (POST /v1/customer-invitations, X-Vision-Key = VISION_AUTOMATION_KEY).
# Customer links look like ${VISION_TRIP_LINK_BASE_URL}/vt_<token>; production requires an https:// value.
VISION_INVITATION_TTL_DAYS=30
# Repeated email requests for the same booking, customer and scope within this window are treated as duplicates.
VISION_INVITATION_DUPLICATE_WINDOW_SECONDS=600
# Optional separate secret for hashing one-time codes (defaults to VISION_LINK_SECRET).
VISION_OTP_SECRET=

# Local development only (ignored, and the endpoint returns 404, when NODE_ENV=production).
# With all three set, the app's entry screen offers "Open development test trip", which creates an invitation for
# this Customer on this Booking. The code is emailed to the Customer, or printed in this console without RESEND_API_KEY.
VISION_DEV_BASE_ID=
VISION_DEV_BOOKING_RECORD_ID=
VISION_DEV_CUSTOMER_RECORD_ID=
MINT_PAYMENT_LINK_ENDPOINT=https://secure.mintpayments.com/mpay/v5/payment-links
AIRTABLE_PAYMENTS_TABLE=Bookings [Payments]
AIRTABLE_BRAND_TEMPLATES_TABLE=Brands & Branches [Templates]
AIRTABLE_ACCEPTANCE_EVIDENCE_FIELD=Quotation Acceptance Evidence

# Optional external content. Leave credentials blank to hide that provider gracefully.
FLIGHT_PROVIDER=aerodatabox
FLIGHT_API_KEY=
FLIGHT_WINDOW_HOURS=48
WEATHER_ENABLED=true
# Server-side only: Places photos are served through /v1/media/place-photo so the key never reaches the app.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_EMBED_KEY=
WIDGETY_BASE_URL=https://www.widgety.co.uk
WIDGETY_APP_ID=
WIDGETY_TOKEN=
WIDGETY_SHIP_PATH=/api/ships/{slug}.json
WIDGETY_HOLIDAY_LOOKUP=/api/cruises.json?reference={ref}
WIDGETY_DESTINATION_LOOKUP=/api/destinations.json?q={name}
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_RESEARCH=true
AIRLINE_LOGO_CDN=https://pics.avs.io/120/60/{iata}@2x.png
SURPRISE_MODE=true
