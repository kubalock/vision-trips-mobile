PORT=3000
AUTH_DATABASE_PATH=.data/auth.sqlite
MOBILE_ORIGIN=http://localhost:4200
AIRTABLE_TOKEN=
AIRTABLE_REQUEST_TIMEOUT_MS=10000
AIRTABLE_MAX_ATTEMPTS=3
AIRTABLE_MIN_REQUEST_INTERVAL_MS=220
AIRTABLE_RETRY_BASE_MS=500
VISION_LINK_SECRET=
VISION_LINK_SECRET_PREVIOUS=
RESEND_API_KEY=
VISION_EMAIL_FROM=Vision Trips <onboarding@resend.dev>
MINT_PAYMENT_LINK_ENDPOINT=https://secure.mintpayments.com/mpay/v5/payment-links
AIRTABLE_PAYMENTS_TABLE=Payments
AIRTABLE_ACCEPTANCE_EVIDENCE_FIELD=Quotation Acceptance Evidence

# Optional external content. Leave credentials blank to hide that provider gracefully.
FLIGHT_PROVIDER=aerodatabox
FLIGHT_API_KEY=
FLIGHT_WINDOW_HOURS=48
WEATHER_ENABLED=true
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_EMBED_KEY=
WIDGETY_BASE_URL=https://www.widgety.co.uk
WIDGETY_APP_ID=
WIDGETY_TOKEN=
WIDGETY_SHIP_PATH=/api/ships/{slug}.json
WIDGETY_HOLIDAY_LOOKUP=/api/cruises.json?reference={ref}
WIDGETY_DESTINATION_LOOKUP=/api/destinations.json?q={name}
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_RESEARCH=true
AIRLINE_LOGO_CDN=https://pics.avs.io/120/60/{iata}@2x.png
SURPRISE_MODE=true
